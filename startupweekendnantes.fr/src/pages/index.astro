---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Hero from '../components/Hero';
import Ticker from '../components/Ticker';
import Intro from '../components/Intro';
import Welcome from '../components/Welcome';
import StatsBand from '../components/StatsBand';
// Section « 12 missions » archivée pour l'instant (hors LP) — remettre <Missions /> ci-dessous pour la réactiver.
// import Missions from '../components/Missions';
import PastGlimpse from '../components/PastGlimpse';
import Pricing from '../components/Pricing';
import Venue from '../components/Venue';
import Team from '../components/Team';
import Agenda from '../components/Agenda';
import OrgTeam from '../components/OrgTeam';
import Sponsors from '../components/Sponsors';
import FAQ from '../components/FAQ';
import Contact from '../components/Contact';
import CtaBand from '../components/CtaBand';
import Footer from '../components/Footer';
import '../styles/global.css';
---

<Layout>
  <Header />
  <main id="main">
    <Hero client:load />
    <Ticker />
    <Intro />
    <Welcome />
    <StatsBand />
    <PastGlimpse client:visible />
    <Pricing />
    <Venue />
    <Team />
    <Agenda />
    <OrgTeam />
    <Sponsors />
    <FAQ client:load />
    <Contact />
    <CtaBand />
  </main>
  <Footer />
</Layout>
