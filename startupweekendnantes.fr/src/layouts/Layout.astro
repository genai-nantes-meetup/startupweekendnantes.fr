---
import { EDITION } from '../data/edition';
import { SITE } from '../data/site';
import { venue } from '../data/venue';
import { buildHomeJsonLd } from '../data/meta';

interface Props {
  title?: string;
  description?: string;
  /** Override the default `index, follow` — e.g. `noindex, follow` on the 404 page. */
  robots?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  robots = 'index, follow',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL(SITE.ogImage, SITE.url).toString();
/** Le JSON-LD Event/FAQ/Organization ne concerne que la page d'accueil. */
const isHome = Astro.url.pathname === '/';
const jsonLd = isHome ? JSON.stringify(buildHomeJsonLd()) : null;

/** PostHog n'est chargé qu'en build de prod ET si le token est fourni (absent en preview). */
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogEnabled = import.meta.env.PROD && Boolean(posthogKey);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={SITE.favicon} type="image/svg+xml" />
    <link rel="icon" href={SITE.favicon32} type="image/png" sizes="32x32" />
    <link rel="icon" href={SITE.favicon16} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={SITE.appleTouchIcon} />
    <link rel="manifest" href={SITE.manifest} />
    <link rel="canonical" href={canonical} />
    <!-- AI-readable digest (llmstxt.org convention) — see src/pages/llms.txt.ts -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé pour IA (llms.txt)" />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content={SITE.themeColor} />

    <!-- SEO local (source unique : src/data/venue.ts) -->
    <meta name="geo.region" content={venue.addressRegionCode} />
    <meta name="geo.placename" content={venue.addressLocality} />
    <meta name="ICBM" content={`${venue.latitude}, ${venue.longitude}`} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <!-- Cal Sans (H1 / t-display) is the LCP text font on most pages — preload it so
         the browser fetches it immediately instead of discovering it via global.css. -->
    <link
      rel="preload"
      as="font"
      href="/fonts/CalSans-Regular.woff2"
      type="font/woff2"
      crossorigin
    />

    <!-- Space Mono only (Cal Sans / Funnel Display / Instrument Sans are self-hosted,
         see global.css). Loaded as a non-render-blocking preload (swapped to
         stylesheet on load) since Space Mono isn't used above the fold on any
         page — a synchronous <link rel="stylesheet"> here was delaying LCP by
         ~750ms for a font that isn't needed for first paint. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://hogpost.naomakers.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
      />
    </noscript>

    <!-- GTM -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-NQ2DKKPD');
    </script>

    <!-- PostHog — prod only, disabled when PUBLIC_POSTHOG_KEY is absent (e.g. Preview deploys). -->
    {
      posthogEnabled && (
        <script
          define:vars={{ phKey: posthogKey, phEdition: EDITION.year }}
          is:inline
        >
          // PostHog array-loader snippet, unmodified — https://posthog.com/docs/libraries/js
          // prettier-ignore
          !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.uploadQueue.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
          posthog.init(phKey, {
            api_host: 'https://hogpost.naomakers.com',
            ui_host: 'https://hogpost.naomakers.com',
            autocapture: true,
            persistence: 'cookie',
            capture_pageview: true,
            capture_pageleave: true,
          });
          posthog.register({ edition: phEdition });
        </script>
      )
    }

    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        /* Slide UP — section text blocks, cards, headers */
        .hero-text,
        .hero-image,
        .intro-content,
        .welcome-content,
        .past-container,
        .team-header,
        .member-card,
        .sponsor-item,
        .pricing-card,
        .agenda-day,
        .faq-item,
        .org-card,
        .contact-container,
        section h2 {
          opacity: 0.001;
          transform: perspective(1200px) translateY(150px);
        }

        /* Slide DOWN — decorative elements from above */
        .hero-dots,
        .hero-circle {
          opacity: 0.001;
          transform: perspective(1200px) translateY(-50px);
        }
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>

    <!-- GTM noscript -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NQ2DKKPD"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <slot />

    <script>
      // Delegated click listener for `data-analytics-event` on static (non-hydrated)
      // components — see src/lib/analytics.ts. Runs regardless of env: capture()
      // is a no-op until PostHog has loaded (dev, or PostHog blocked/absent).
      import { initClickTracking } from '../lib/analytics';

      initClickTracking();
    </script>

    <script>
      import { animateMini, inView } from 'motion';

      // motion's MarginType is not exported; mirror the template-literal shape here.
      type MarginValue = `${number}${'px' | '%'}`;
      type Margin = MarginValue | `${MarginValue} ${MarginValue}`;

      /* Framer-matching easing: fast start, slow settle — cubic-bezier(0.25, 0.1, 0.25, 1) */
      const EASE = [0.25, 0.1, 0.25, 1] as const;
      const DURATION = 0.7;
      const TO_ZERO = 'perspective(1200px) translateY(0px)';

      const DEFAULT_MARGIN: Margin = '-80px 0px';
      const CARD_MARGIN: Margin = '-40px 0px';
      const ROW_MARGIN: Margin = '-20px 0px';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {

        /* ── Slide UP: main content ───────────────────────────── */
        const slideUp = (selector: string, delay = 0, margin: Margin = DEFAULT_MARGIN) => {
          inView(
            selector,
            (el) => {
              animateMini(
                el,
                { opacity: 1, transform: TO_ZERO },
                { duration: DURATION, delay, ease: EASE }
              );
            },
            { margin }
          );
        };

        // Hero elements — staggered
        slideUp('.hero-text', 0);
        slideUp('.hero-image', 0.1);

        // Section h2 headings
        slideUp('section h2');

        // Content blocks
        slideUp('.intro-content');
        slideUp('.welcome-content');
        slideUp('.past-container');
        slideUp('.team-header');
        slideUp('.contact-container');

        // Cards — stagger by sibling index (Framer-style)
        const animateCard = (el: Element, stagger: number) => {
          const idx = [...(el.parentElement?.children ?? [])].indexOf(el);
          animateMini(
            el,
            { opacity: 1, transform: TO_ZERO },
            { duration: 0.6, delay: idx * stagger, ease: EASE }
          );
        };

        inView('.member-card, .org-card', (el) => animateCard(el, 0.07), { margin: CARD_MARGIN });
        inView('.pricing-card', (el) => animateCard(el, 0.1), { margin: CARD_MARGIN });

        // Agenda rows and FAQ items
        slideUp('.agenda-day', 0, ROW_MARGIN);
        slideUp('.faq-item', 0, ROW_MARGIN);

        /* ── Slide DOWN: decorative elements ─────────────────── */
        inView('.hero-dots, .hero-circle', (el) => {
          animateMini(
            el,
            { opacity: 1, transform: TO_ZERO },
            { duration: 0.6, ease: EASE }
          );
        });

      }
    </script>
  </body>
</html>
